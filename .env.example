# ============================================================
#  Copy this file to .env and fill in YOUR values.
#  .env is git-ignored — never commit it.
# ============================================================

# --- Camera ---------------------------------------------------
# Format: rtsp://username:password@ip_address:port/stream_path
RTSP_STREAM=rtsp://USERNAME:PASSWORD@CAMERA_IP:554/

# --- Paths (leave blank to use current directory) -------------
# DASHBOARD_DIR=D:\vehicle_speed\no_plate
# MODEL_PATH=runs/detect/license_plate_detection/weights/best.pt
# YOLO_CAR_MODEL=yolov8n.pt

# --- Tesseract OCR --------------------------------------------
# Windows default path — change if installed elsewhere
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux / macOS: TESSERACT_CMD=/usr/bin/tesseract

# --- MongoDB --------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=enhanced_vehicle_db
MONGO_COLLECTION_NAME=vehicle_records

# --- Flask Dashboard ------------------------------------------
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

