# Auto-detect text files and enforce LF on all platforms
* text=auto eol=lf

# Explicitly declare Python as text
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.csv text eol=lf

# Declare binary files so Git doesn't try to diff them
*.pt binary
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.avi binary
*.zip binary

